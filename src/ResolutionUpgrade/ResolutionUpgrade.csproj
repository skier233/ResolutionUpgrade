  </ItemGroup>

  <!-- Cove host contracts (Cove.Sdk + Cove.Core) are referenced centrally and compile-only by
       ..\..\Directory.Build.targets. Metadata lives in extension.json (copied centrally by
       ..\..\Directory.Build.props). -->
</Project>
