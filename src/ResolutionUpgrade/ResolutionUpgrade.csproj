<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ResolutionUpgrade</AssemblyName>
    <RootNamespace>ResolutionUpgrade</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Maps HTTP endpoints, so it needs the ASP.NET Core shared framework (host-provided at runtime). -->
